---
// src/components/Photos.astro
import { Picture } from "astro:assets";
import snowTrees from "../assets/photos/snow-trees.jpg";
import lilly from "../assets/photos/lilly.jpg";
import summerSonic from "../assets/photos/summer-sonic.jpg";
import smoothOperator from "../assets/photos/smooth-operator.jpg";
import goldsGym from "../assets/photos/golds-gym.jpg";

const photos = [
  { src: snowTrees, alt: "Snow covered trees", rotation: "rotate-positive" },
  { src: lilly, alt: "Lilly", rotation: "rotate-negative" },
  { src: summerSonic, alt: "Summer sonic 2025", rotation: "rotate-positive" },
  {
    src: smoothOperator,
    alt: "Burton Smooth-operator",
    rotation: "rotate-positive",
  },
  { src: goldsGym, alt: "Gold's gym", rotation: "rotate-negative" },
];
---

<div class="photos">
  <div class="photos-inner">
    {
      photos.map((photo, index) => (
        <div class={`photo-frame ${photo.rotation}`}>
          <div class="photo-aspect">
            <Picture
              src={photo.src}
              formats={["avif", "webp"]}
              alt={photo.alt}
              priority={index === 0}
            />
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .photos {
    margin-top: 4rem;
  }

  .photos-inner {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    overflow: hidden;
    padding-block: 1rem;
    margin-block: -1rem;
  }

  .photo-frame {
    position: relative;
    flex: none;
    width: 11rem;
    overflow: hidden;
    border-radius: 0.75rem;
    background: #f4f4f5;
  }

  .photo-aspect {
    aspect-ratio: 9 / 10;
  }

  .photo-aspect :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .photo-aspect :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rotate-positive {
    transform: rotate(2deg);
  }

  .rotate-negative {
    transform: rotate(-2deg);
  }

  @media (min-width: 640px) {
    .photos {
      margin-top: 5rem;
    }

    .photos-inner {
      gap: 2rem;
    }

    .photo-frame {
      width: 18rem;
      border-radius: 1rem;
    }
  }
</style>
