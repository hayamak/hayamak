---
import image1 from "../assets/photos/image-1.jpg";
import image2 from "../assets/photos/image-2.jpg";
import image3 from "../assets/photos/image-3.jpg";
import image4 from "../assets/photos/image-4.jpg";
import image5 from "../assets/photos/image-5.jpg";

const photos = [
  { src: image1.src, alt: "", rotation: "rotate-positive" },
  { src: image2.src, alt: "", rotation: "rotate-negative" },
  { src: image3.src, alt: "", rotation: "rotate-positive" },
  { src: image4.src, alt: "", rotation: "rotate-positive" },
  { src: image5.src, alt: "", rotation: "rotate-negative" },
];
---

<!-- src/components/Photos.astro -->
<div class="photos">
  <div class="photos-inner">
    {
      photos.map((photo) => (
        <div class={`photo-frame ${photo.rotation}`}>
          <div class="photo-aspect">
            <img src={photo.src} alt={photo.alt} loading="lazy" />
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .photos {
    margin-top: 4rem;
  }

  .photos-inner {
    display: flex;
    justify-content: center;
    gap: 1.25rem;
    overflow: hidden;
    padding-block: 1rem;
    margin-block: -1rem;
  }

  .photo-frame {
    position: relative;
    flex: none;
    width: 11rem;
    overflow: hidden;
    border-radius: 0.75rem;
    background: #f4f4f5;
  }

  .photo-aspect {
    aspect-ratio: 9 / 10;
  }

  .photo-aspect img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rotate-positive {
    transform: rotate(2deg);
  }

  .rotate-negative {
    transform: rotate(-2deg);
  }

  @media (min-width: 640px) {
    .photos {
      margin-top: 5rem;
    }

    .photos-inner {
      gap: 2rem;
    }

    .photo-frame {
      width: 18rem;
      border-radius: 1rem;
    }
  }
</style>
