---
// src/components/ContentPhotos.astro
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Photo {
  src: ImageMetadata;
  alt: string;
  rotation?: "positive" | "negative";
}

interface Props {
  photos: readonly Photo[];
}

const { photos }: Props = Astro.props;
---

<div class="content-photos-viewport">
  <div class="content-photos">
    {
      photos.map((photo) => (
        <div class={`photo-frame ${photo.rotation ?? "positive"}`}>
          <div class="photo-aspect">
            <Picture
              src={photo.src}
              formats={["avif", "webp"]}
              alt={photo.alt}
            />
          </div>
        </div>
      ))
    }
  </div>
</div>

<style>
  .content-photos-viewport {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    overflow: hidden;
    margin-block: 3rem;
  }

  .content-photos {
    display: flex;
    justify-content: center;
    gap: 0.875rem;

    padding-block: 1rem;
    margin-block: -1rem;
  }

  .photo-frame {
    flex: none;
    width: clamp(8rem, 34vw, 11rem);
    overflow: hidden;
    border-radius: 0.75rem;
    background: #f4f4f5;
  }

  .photo-aspect {
    aspect-ratio: 9 / 10;
  }

  .photo-aspect :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .photo-aspect :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .positive {
    transform: rotate(2deg);
  }

  .negative {
    transform: rotate(-2deg);
  }

  @media (min-width: 640px) {
    .content-photos-viewport {
      width: auto;
      margin-inline: 0;
      overflow: visible;
      margin-block: 4rem;
    }

    .content-photos {
      gap: 1.5rem;
      max-width: 42rem;
    }

    .photo-frame {
      width: 13rem;
      border-radius: 1rem;
    }
  }
</style>
