---
interface Props {
  title: string;
  description: string;
  date: string;
  href: string;
}

const { title, description, date, href } = Astro.props;
---

<article class="journal-card">
  <a class="journal-link" href={href} aria-label={`${title} を読む`}>
    <span class="journal-link-hitarea"></span>
    <h2 class="journal-title">{title}</h2>
  </a>

  <time datetime={date} class="journal-date">{date}</time>

  <p>{description}</p>

  <div class="journal-cta" aria-hidden="true">
    続きを読む
    <svg viewBox="0 0 16 16" fill="none">
      <path
        d="M6.75 5.75 9.25 8l-2.5 2.25"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>
</article>

<style>
  .journal-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .journal-card::before {
    content: "";
    position: absolute;
    inset: -1.5rem -1rem;
    z-index: 0;
    border-radius: 1rem;
    background: #fafafa;
    opacity: 0;
    transform: scale(0.95);

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .journal-card:hover::before {
    opacity: 1;
    transform: scale(1);
  }

  .journal-link {
    position: relative;
    z-index: 10;
    text-decoration: none;
  }

  .journal-link-hitarea {
    position: absolute;
    inset: -1.5rem -1rem;
    z-index: 20;
    border-radius: 1rem;
  }

  .journal-title {
    position: relative;
    z-index: 30;
    margin: 0;

    color: var(--color-text);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .journal-date {
    position: relative;
    z-index: 10;
    order: -1;
    margin-bottom: 0.75rem;
    padding-left: 0.875rem;
    color: #a1a1aa;
    font-size: 0.875rem;
  }

  .journal-date::before {
    content: "";
    position: absolute;
    top: 0.2rem;
    bottom: 0.2rem;
    left: 0;
    width: 2px;
    border-radius: 999px;
    background: #e4e4e7;
  }

  .journal-card p {
    position: relative;
    z-index: 10;
    margin-top: 0.5rem;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .journal-cta {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    margin-top: 1rem;

    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .journal-cta svg {
    margin-left: 0.25rem;
    width: 1rem;
    height: 1rem;
  }
</style>
