---
interface Props {
  title: string;
  description: string;
  date: string;
  href: string;
}

const { title, description, date, href } = Astro.props;
---

<a class="journal-card" href={href} aria-label={`${title} を読む`}>
  <time datetime={date} class="journal-date">{date}</time>

  <h2 class="journal-title">{title}</h2>

  <p>{description}</p>

  <div class="journal-cta" aria-hidden="true">
    続きを読む
    <svg viewBox="0 0 16 16" fill="none">
      <path
        d="M6.75 5.75 9.25 8l-2.5 2.25"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>
</a>

<style>
  .journal-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    margin: -1.5rem -1rem;
    padding: 1.5rem 1rem;
    border-radius: 1rem;

    color: inherit;
    text-decoration: none;

    transition: background-color 0.2s ease;
    transform 0.2s ease;
  }

  .journal-card:hover {
    background: #fafafa;
    transform: translateY(-1px);
  }

  .journal-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .journal-title {
    margin: 0;

    color: var(--color-text);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .journal-date {
    margin-bottom: 0.75rem;
    padding-left: 0.875rem;

    position: relative;

    color: #a1a1aa;
    font-size: 0.875rem;
  }

  .journal-date::before {
    content: "";
    position: absolute;
    top: 0.2rem;
    bottom: 0.2rem;
    left: 0;
    width: 2px;
    border-radius: 999px;
    background: #e4e4e7;
  }

  .journal-card p {
    margin-top: 0.5rem;

    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .journal-cta {
    display: flex;
    align-items: center;
    margin-top: 1rem;

    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .journal-cta svg {
    margin-left: 0.25rem;
    width: 1rem;
    height: 1rem;

    transition: transform 0.2s ease;
  }

  .journal-card:hover .journal-cta svg {
    transform: translateX(2px);
  }
</style>
