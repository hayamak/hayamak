---
// src/components/ContentLayout.astro

interface Props {
  title: string;
  intro: string;
}

const { title, intro } = Astro.props;
---

<section class="content-layout">
  <div class="container">
    <header class="content-header">
      <h1>{title}</h1>
      <p>{intro}</p>
    </header>

    <div class="content">
      <slot />
    </div>
  </div>
</section>

<style>
  .content-layout {
    margin-top: 4rem;
  }

  .content-header {
    max-width: 640px;
  }

  .content-header h1 {
    margin: 0;
    font-size: clamp(2.25rem, 6vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .content-header p {
    margin-top: 1.5rem;
    color: var(--color-muted);
  }

  .content {
    margin-top: 4rem;
  }

  @media (min-width: 640px) {
    .content {
      margin-top: 5rem;
    }
  }

  @media (min-width: 1024px) {
    .content-layout {
      margin-top: 8rem;
    }
  }
</style>
