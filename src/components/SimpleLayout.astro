---
// src/components/SimpleLayout.astro
interface Props {
  title: string;
  intro: string;
}

const { title, intro } = Astro.props;
---

<section class="simple-layout">
  <div class="container">
    <header class="simple-header">
      <h1>{title}</h1>
      <p>{intro}</p>
    </header>

    <div class="simple-content">
      <slot />
    </div>
  </div>
</section>

<style>
  .simple-layout {
    margin-top: 4rem;
  }

  .simple-header {
    max-width: 640px;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 6vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  p {
    margin-top: 1.5rem;
    color: var(--color-muted);
  }

  .simple-content {
    margin-top: 4rem;
  }

  @media (min-width: 640px) {
    .simple-content {
      margin-top: 5rem;
    }
  }
</style>
