---
// src/components/Footer.astro
const navItems = [
  { href: "/", label: "ホーム" },
  { href: "/journal", label: "あれこれ" },
  { href: "/music", label: "音楽" },
  { href: "/espanol", label: "Español" },
  { href: "/snowboard", label: "スノーボード" },
  { href: "/gym", label: "ジム" },
  { href: "/privacy", label: "プライバーポリシー" },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-inner">
      <nav aria-label="フッターナビゲーション">
        <ul class="footer-nav">
          {
            navItems.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <p>
        &copy; {new Date().getFullYear()} Hayama
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 8rem;
    padding-top: 2.5rem;
    padding-bottom: 4rem;
    border-top: 1px solid #f4f4f5;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: center;
    text-align: center;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-nav a {
    color: var(--color-muted);
    text-decoration: none;
    /* transition: color 0.2s ease; */
    font-size: 0.875rem;
  }

  .footer-nav a:hover {
    color: var(--color-text);
  }

  .footer-inner p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  @media (min-width: 768px) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
    }

    .footer-nav {
      justify-content: flex-start;
    }
  }
</style>
