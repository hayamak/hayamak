---
// src/components/Profile.astro
import { Picture } from "astro:assets";
import me from "../assets/photos/me.jpg";
---

<div class="profile-card">
  <h2>プロフィール</h2>

  <div class="profile-avatar">
    <Picture
      src={me}
      alt="羽山 和行"
      widths={[120, 240]}
      sizes="120px"
      formats={["avif", "webp"]}
    />
  </div>

  <div class="profile-list">
    <p>千葉県南房総市出身、東京都中央区在住のO型、1969年3月生まれ魚座です。</p>
    <div class="profile-item">
      <span class="profile-label">身長</span>
      <span class="profile-value">170cm</span>
    </div>

    <div class="profile-item">
      <span class="profile-label">体重</span>
      <span class="profile-value">65〜83kg位</span>
    </div>

    <div class="profile-item">
      <span class="profile-label">血圧</span>
      <span class="profile-value">118 / 81</span>
    </div>
    <div class="profile-item">
      <span class="profile-label">視力</span>
      <span class="profile-value">0.8 / 0.8</span>
    </div>
  </div>
  <p class="profile-note">※ 2026年3月現在</p>
</div>

<style>
  .profile-card {
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    padding: 1.5rem;
  }

  h2 {
    margin: 0;
    font-size: 0.875rem;
  }

  .profile-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-top: 1.5rem;
  }

  .profile-list > p {
    margin: 0 0 0.5rem;
    color: var(--color-text);
    line-height: 1.8;
    font-size: 0.9375rem;
  }

  .profile-item {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
  }

  .profile-label {
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .profile-value {
    color: var(--color-text);
  }

  .profile-note {
    margin: 1.25rem 0 0;
    color: var(--color-muted);
    font-size: 0.75rem;
    text-align: right;
  }

  .profile-avatar {
    display: flex;
    justify-content: center;
    margin-top: 1.5rem;
  }

  .profile-avatar :global(img) {
    display: block;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
  }
</style>
