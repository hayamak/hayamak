---
// src/components/Profile.astro
---

<div class="profile-card">
  <h2>プロフィール</h2>

  <div class="profile-list">
    <div class="profile-item">
      <span class="profile-label">身長</span>
      <span class="profile-value">170cm</span>
    </div>

    <div class="profile-item">
      <span class="profile-label">体重</span>
      <span class="profile-value">65〜83kg位</span>
    </div>

    <div class="profile-item">
      <span class="profile-label">血液型</span>
      <span class="profile-value">O型</span>
    </div>
    <div class="profile-item">
      <span class="profile-label">血圧</span>
      <span class="profile-value">118 / 81</span>
    </div>
    <div class="profile-item">
      <span class="profile-label">視力</span>
      <span class="profile-value">0.8 / 0.8</span>
    </div>

    <div class="profile-item">
      <span class="profile-label">星座</span>
      <span class="profile-value">魚座</span>
    </div>
  </div>
  <p class="profile-note">※ 2026年3月現在</p>
</div>

<style>
  .profile-card {
    border: 1px solid #f4f4f5;
    border-radius: 1rem;
    padding: 1.5rem;
  }

  h2 {
    margin: 0;
    font-size: 0.875rem;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .profile-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .profile-item {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
  }

  .profile-label {
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .profile-value {
    color: var(--color-text);
  }

  .profile-note {
    margin: 1.5rem 0 0;
    color: var(--color-muted);
    font-size: 0.75rem;
    opacity: 0.7;
    text-align: right;
  }
</style>
