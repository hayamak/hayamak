      <div class="word-list">
        <span>favorito</span>
        <span>bailar</span>
        <span>mañana</span>
        <span>corazón</span>
      </div>
    </section> -->
  </ContentLayout>
</Layout>

<style>
  .espanol-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 80px 24px 120px;
  }

  .hero {
    padding: 72px 0 56px;
  }

  .eyebrow {
    margin: 0 0 16px;
    color: #58a700;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero {
    max-width: 720px;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .lead {
    margin-top: 1.5rem;
  }

  .intro {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 48px;
    align-items: center;
    padding: 56px 0;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  h2 {
    margin: 0 0 20px;
    font-size: 1.75rem;
    letter-spacing: -0.04em;
  }

  p {
    line-height: 1.9;
  }

  .duolingo-shot {
    margin: 0;
    padding: 16px;
    border-radius: 28px;
    background: #fff;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.08);
  }

  .duolingo-shot img {
    width: 100%;
    border-radius: 20px;
    display: block;
  }

  .duolingo-shot figcaption {
    margin-top: 12px;
    color: var(--color-muted);
    font-size: 0.875rem;
    text-align: center;
  }

  .road,
  .words {
    padding: 56px 0;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .steps {
    display: grid;
    gap: 16px;
  }

  .step {
    padding: 24px;
    border-radius: 24px;
    background: #f0fdf4;
  }

  .step span {
    color: #58a700;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .step h3 {
    margin: 8px 0;
    font-size: 1.25rem;
  }

  .step p {
    margin: 0;
    color: var(--color-muted);
  }

  .word-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .word-list span {
    padding: 10px 16px;
    border-radius: 999px;
    background: #fff7ed;
    font-size: 1.1rem;
  }

  @media (max-width: 720px) {
    .espanol-page {
      padding-top: 40px;
    }

    .intro {
      grid-template-columns: 1fr;
    }

    .duolingo-shot {
      max-width: 320px;
    }
  }
</style>
