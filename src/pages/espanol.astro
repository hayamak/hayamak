---
// src/pages/espanol.astro

import Layout from "../layouts/Layout.astro";
import ContentLayout from "../layouts/ContentLayout.astro";
import ContentPhotos from "../components/ContentPhotos.astro";

import mykeTowers from "../assets/photos/myke-towers.jpg";
import unVeranoSinTi from "../assets/photos/un-verano-sin-ti.jpg";
import duolingo from "../assets/photos/duolingo.jpg";

const photos = [
  {
    src: mykeTowers,
    alt: "La Vida es Una",
    rotation: "negative",
  },

  {
    src: unVeranoSinTi,
    alt: "Un Verano Sin Ti - Bad Bunny",
    rotation: "negative",
  },

  { src: duolingo, alt: "Duolingo", rotation: "positive" },
] as const;
---

<Layout title="Mi Español">
  <ContentLayout title="Mi Español">
    <Fragment slot={"intro"}>
      たしかジムで<em>LALA - Myke Towers</em
      >が流れてきたのをきっかけに、一時期ラテンアメリカの音楽にハマっていた。その時にスペイン語の勉強を始めました。
    </Fragment>
    <ContentPhotos photos={photos} />

    <section class="espanol-content">
      <p>
        今は生成AIに聞けばすぐに日本語から他の言語に、他の言語から日本語に翻訳してくれるのでわざわざ外国語を学ばなくても生活するのに支障はないし海外に行っても困ることはないと思う。
      </p>
      <p>
        自分の場合、スペイン語の勉強は完全に趣味。Duolingoで移動中のちょっとした時間に勉強できるのが便利。でも、日常でDuolingo以外ではスペイン語に触れる機会がなくてまだ会話ができる気はしない。
      </p>
      <p>
        2026年2月のSuper Bowl
        LXのハーフタイムショーへの出演が決まった時から物議を醸していたけど、スペイン語で歌い通したBad
        Bunnyかっこよかったな〜。
      </p>
      <a
        class="youtube-card"
        href="https://youtu.be/G6FuWd4wNd8?si=pvHq5kZksTlHSKT0"
        target="_blank"
        rel="noopener noreferrer"
      >
        <div class="youtube-thumbnail">
          <img
            src="https://img.youtube.com/vi/G6FuWd4wNd8/maxresdefault.jpg"
            alt="Bad Bunny - Super Bowl LX Halftime Show"
          />

          <div class="youtube-play" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 6v12l10-6-10-6z"></path>
            </svg>
          </div>
        </div>
      </a>
    </section>
  </ContentLayout>
</Layout>

<style>
  .espanol-content {
    max-width: 42rem;
    color: var(--color-text);
    line-height: 1.9;
  }

  .espanol-content p {
    margin: 0;
  }

  .espanol-content p + p {
    margin-top: 1.5rem;
  }

  .youtube-card {
    display: block;
    max-width: 42rem;
    margin-top: 2rem;

    color: inherit;
    text-decoration: none;
  }

  .youtube-thumbnail {
    position: relative;
  }

  .youtube-thumbnail img {
    display: block;
    width: 100%;
    border-radius: 1rem;
    border: 1px solid var(--color-border);
  }

  .youtube-play {
    position: absolute;
    inset: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    pointer-events: none;
  }

  .youtube-play::before {
    content: "";

    width: 4.25rem;
    height: 3rem;

    border-radius: 0.75rem;
    background: rgba(255, 0, 0, 0.9);
  }

  .youtube-play svg {
    position: absolute;

    width: 1.5rem;
    height: 1.5rem;

    color: white;
  }

  .youtube-card:hover .youtube-play::before {
    background: #ff0033;
  }
</style>
