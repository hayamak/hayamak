  <ContentLayout
    title="Mi Español"
    intro="ラテンアメリカの音楽にハマった時にスペイン語の勉強を始めました。日常でDuolingo以外はスペイン語に触れる機会がなくてまだ喋れる気がしない。"
  >
    <ContentPhotos photos={photos} />

    <section></section>
