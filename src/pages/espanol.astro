---
import Layout from "../layouts/Layout.astro";
import ContentLayout from "../components/ContentLayout.astro";
import ContentPhotos from "../components/ContentPhotos.astro";

import unVeranoSinTi from "../assets/photos/un-verano-sin-ti.jpg";
import superBowlXL from "../assets/photos/super-bowl-lx-halftime-show.jpg";
import myokosan from "../assets/photos/myokosan.jpg";

const photos = [
  {
    src: unVeranoSinTi,
    alt: "Un Verano Sin Ti - Bad Bunny",
    rotation: "negative",
  },
  {
    src: superBowlXL,
    alt: "Super Bowl LX Halftime show - Bad Bunny",
    rotation: "negative",
  },

  { src: myokosan, alt: "ワンカップ妙高山", rotation: "positive" },
] as const;
---

