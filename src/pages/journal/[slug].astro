---
// src/pages/journal/[slug].astro

// export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import JournalLayout from "../../layouts/JournalLayout.astro";

import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const journals = await getCollection("journals");

  return journals.map((journal) => ({
    params: {
      slug: journal.id,
    },
    props: {
      journal,
    },
  }));
}

const { journal } = Astro.props;

const { Content } = await render(journal);
---

<Layout title={`${journal.data.title} - 羽山`}>
  <JournalLayout
    title={journal.data.title}
    date={journal.data.pubDate.toISOString().slice(0, 10)}
  >
    <Content />
  </JournalLayout>
</Layout>
