---
// src/pages/journal/[...page].astro

import Layout from "../../layouts/Layout.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import JournalCard from "../../components/JournalCard.astro";

import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";

export const getStaticPaths = (async ({ paginate }) => {
  const journals = await getCollection("journals");

  // 日付順にソート
  journals.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

  // 1ページあたり10件に分割
  return paginate(journals, { pageSize: 10 });
}) satisfies GetStaticPaths; // satisfies で型を適用

// Astro.props から page オブジェクトを受け取る
const { page } = Astro.props;
---

<Layout title="あれこれ">
  <ContentLayout title="あれこれ">
    <Fragment slot={"intro"}>
      技術の話題を中心に、音楽、スペイン語、スノーボードやジムなどの関心ごとについてあれこれ記録します。
    </Fragment>
    <section class="journal-list">
      {
        page.data.map((journal) => (
          <JournalCard
            title={journal.data.title}
            description={journal.data.description}
            date={journal.data.pubDate.toISOString().slice(0, 10)}
            href={`/journal/${journal.id}`}
          />
        ))
      }
    </section>

    <!-- ナビゲーション -->
    <nav class="pagination" aria-label="Journalのページ送り">
      <div class="pagination-side">
        {
          page.url.prev && (
            <a href={page.url.prev} class="pagination-link">
              <span class="arrow" aria-hidden="true">
                ←
              </span>
              前へ
            </a>
          )
        }
      </div>

      <span class="pagination-status">
        {page.currentPage} / {page.lastPage}
      </span>

      <div class="pagination-side pagination-side-next">
        {
          page.url.next && (
            <a href={page.url.next} class="pagination-link">
              次へ
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          )
        }
      </div>
    </nav>
  </ContentLayout>
</Layout>

<style>
  .journal-list {
    display: flex;
    max-width: 48rem;
    flex-direction: column;
    gap: 4rem;
  }

  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;

    max-width: 48rem;
    margin-top: 4rem;
    padding-top: 1.5rem;

    border-top: 1px solid #f4f4f5;
  }

  .pagination-side {
    display: flex;
  }

  .pagination-side-next {
    justify-content: flex-end;
  }

  .pagination-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;

    color: var(--color-muted);
    font-size: 0.875rem;
    text-decoration: none;

    transition: color 0.2s ease;
  }

  .pagination-link:hover {
    color: var(--color-text);
  }

  .pagination-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .pagination-status {
    color: var(--color-muted);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .arrow {
    color: #a1a1aa;
  }

  .pagination-link:hover .arrow {
    color: currentColor;
  }

  @media (min-width: 768px) {
    .journal-list {
      border-left: 1px solid #f4f4f5;
      padding-left: 1.5rem;
    }
  }
</style>
