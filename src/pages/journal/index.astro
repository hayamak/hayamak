---
// src/pages/journal/index.astro

import Layout from "../../layouts/Layout.astro";
import ContentLayout from "../../layouts/ContentLayout.astro";
import JournalCard from "../../components/JournalCard.astro";

import { getCollection } from "astro:content";

const journals = await getCollection("journals");

journals.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="あれこれ">
  <ContentLayout title="あれこれ">
    <Fragment slot={"intro"}>
      ここに技術の話題を中心に、音楽、スペイン語、スノーボードやジムなどの関心ごとについてあれこれ記録します。
    </Fragment>
    <section class="journal-list">
      {
        journals.map((journal) => (
          <JournalCard
            title={journal.data.title}
            description={journal.data.description}
            date={journal.data.pubDate.toISOString().slice(0, 10)}
            href={`/journal/${journal.id}`}
          />
        ))
      }
    </section>
  </ContentLayout>
</Layout>

<style>
  .journal-list {
    display: flex;
    max-width: 48rem;
    flex-direction: column;
    gap: 4rem;
  }

  @media (min-width: 768px) {
    .journal-list {
      border-left: 1px solid #f4f4f5;
      padding-left: 1.5rem;
    }
  }
</style>
