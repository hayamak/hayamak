---
// src/pages/index.astro

import Layout from "../layouts/Layout.astro";
import XIcon from "../components/icons/XIcon.astro";
import Instagram from "../components/icons/Instagram.astro";
import Github from "../components/icons/Github.astro";
import Photos from "../components/Photos.astro";
import Profile from "../components/Profile.astro";
import JournalCard from "../components/JournalCard.astro";

const journals = [
  {
    title: "最初の記録",
    description: "音楽、スペイン語、スノーボードなどについて書いていきます。",
    date: "2026-06-21",
    slug: "first-post",
  },
];
---

<Layout
  title="羽山 - Hayama"
  description="羽山和行のホームページです。個人的に関心のある音楽、スペイン語、スノーボード、ジムに関して記録するサイトです。"
>
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <h1>羽山和行のホームページ</h1>
        <p>
          音楽、スペイン語、スノーボード、ジムなど個人的な関心ごとの記録です。
          その他に花や果物が好きなのでそれらについても記録します。特に好きな花はユリ、クチナシ、テイカカズラ、果物は桃、さくらんぼ、いちごです。
        </p>
        <div class="social-links">
          <a href="#" aria-label="X">
            <XIcon />
          </a>
          <a href="#" aria-label="Instagram">
            <Instagram />
          </a>
          <a href="https://github.com/hayamak" aria-label="GitHub">
            <Github />
          </a>
          <!-- 
          <a href="#" aria-label="LinkedIn">
            <SocialIcon name="linkedin" />
          </a> -->
        </div>
      </div>
    </div>
  </section>
  <Photos />

  <section class="home-section">
    <div class="container home-grid">
      <div class="journal-list">
        {
          journals.map((journal) => (
            <JournalCard
              title={journal.title}
              description={journal.description}
              date={journal.date}
              href={`/journal/${journal.slug}`}
            />
          ))
        }
      </div>
      <div>
        <Profile />
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: 4rem 3rem;
  }

  .hero-inner {
    max-width: 640px;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .hero p {
    margin-top: 1.5rem;
    color: var(--color-muted);
  }

  .home-section {
    padding-top: 6rem;
    padding-bottom: 4rem;
  }
  .home-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  h2 {
    margin: 0;
    font-size: 0.875rem;
  }

  .home-grid p {
    margin-top: 0.5rem;
    color: var(--color-muted);
  }
  .social-links {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .social-links a {
    display: inline-flex;
    color: var(--color-muted);
    transition: color 0.2s ease;
  }

  .social-links a:hover {
    color: var(--color-text);
  }

  .journal-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    padding-top: 1.5rem;
  }

  @media (min-width: 768px) {
    .home-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
