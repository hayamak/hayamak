---
// src/pages/index.astro

import Layout from "../layouts/Layout.astro";
import XIcon from "../components/icons/XIcon.astro";
import Instagram from "../components/icons/Instagram.astro";
import Github from "../components/icons/Github.astro";
import Photos from "../components/Photos.astro";
import Profile from "../components/Profile.astro";
import JournalCard from "../components/JournalCard.astro";

import { getCollection } from "astro:content";

const journals = await getCollection("journals");

journals.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const recentJournals = journals.slice(0, 4);
---

<Layout
  title=""
  description="羽山 和行のホームページです。ウェブ技術の話題を中心に、音楽、スペイン語、スノーボードやジムなどの関心ごとについても記録します。"
>
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <h1>羽山 和行</h1>
        <p>ウェブ技術のキャッチアップのためにこのサイトを作ってみました。</p>
        <p>
          技術の話題を中心に、音楽、スペイン語、スノーボードやジムなどの関心ごとについても記録します。
        </p>
        <div class="social-links">
          <a
            href="https://github.com/hayamak"
            aria-label="GitHub"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Github />
          </a>
          <a
            href="#"
            aria-label="Instagram"
            target="_blank"
            rel="noopener noreferrer"
          >
            <Instagram />
          </a>
          <a
            href="https://x.com/hayamakaz?s=11"
            aria-label="X"
            target="_blank"
            rel="noopener noreferrer"
          >
            <XIcon />
          </a>
        </div>
      </div>
    </div>
  </section>
  <Photos />

  <section class="home-section">
    <div class="container home-grid">
      <section>
        <div class="journal-list">
          {
            recentJournals.map((journal) => (
              <JournalCard
                title={journal.data.title}
                description={journal.data.description}
                date={journal.data.pubDate.toISOString().slice(0, 10)}
                href={`/journal/${journal.id}`}
              />
            ))
          }
        </div>
        <a class="journal-more" href="/journal"> すべて見る → </a>
      </section>
      <div>
        <Profile />
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: 4rem 3rem;
  }

  @media (min-width: 1024px) {
    .hero {
      padding-block: 8rem 4rem;
    }
  }

  .hero-inner {
    max-width: 640px;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .hero h1 + p {
    margin-top: 1.5rem;
  }

  .hero p {
    margin: 0;
    color: var(--color-muted);
  }

  .home-section {
    padding-top: 6rem;
    padding-bottom: 4rem;
  }
  .home-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  h2 {
    margin: 0;
    font-size: 0.875rem;
  }

  .home-grid p {
    margin-top: 0.5rem;
    color: var(--color-muted);
  }
  .social-links {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .social-links a {
    display: inline-flex;
    color: var(--color-muted);
    transition: color 0.2s ease;
  }

  .social-links a:hover {
    color: var(--color-text);
  }

  .journal-list {
    display: flex;
    flex-direction: column;
    gap: 4rem;
    padding-top: 1.5rem;
  }

  .journal-more {
    display: inline-block;
    margin-top: 2rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .journal-more:hover,
  .journal-more:focus-visible {
    color: var(--color-text);
  }
  @media (min-width: 768px) {
    .home-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
