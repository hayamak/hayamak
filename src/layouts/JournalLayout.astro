---
// src/layouts/JournalLayout.astro

interface Props {
  title: string;
  date: string;
}

const { title, date } = Astro.props;
---

<article class="journal-article">
  <a href="/journal" class="back-link">
    <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path
        d="M7.25 11.25 3.75 8m0 0 3.5-3.25M3.75 8h8.5"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>

    <span>一覧へ戻る</span>
  </a>

  <header>
    <time datetime={date}>{date}</time>

    <h1>{title}</h1>
  </header>

  <div class="journal-content">
    <slot />
  </div>
</article>

<style>
  .journal-article {
    width: min(42rem, calc(100% - 3rem));
    margin-inline: auto;
    margin-top: 4rem;
  }

  header {
    display: flex;
    flex-direction: column;
  }

  time {
    order: -1;
    padding-left: 0.875rem;
    color: #a1a1aa;
    font-size: 0.875rem;
    border-left: 2px solid #e4e4e7;
  }

  h1 {
    margin-top: 2rem;
    margin-bottom: 0;
    font-size: clamp(2.25rem, 6vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
  }

  .journal-content {
    margin-top: 4rem;
  }

  .journal-content :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: 1.5rem;
  }

  .journal-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
  }

  .journal-content :global(p) {
    margin: 1.5rem 0;
  }

  /* Markdown images */
  .journal-content :global(img) {
    display: block;
    width: 100%;
    max-width: 480px;
    margin: 2.5rem auto;
    border: 1px solid #f4f4f5;
    border-radius: 0.75rem;
  }

  .journal-content :global(ul) {
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
  }

  .journal-content :global(li) {
    position: relative;
    padding-left: 1.25rem;
  }

  .journal-content :global(li)::before {
    content: "-";
    position: absolute;
    left: 0;
    color: #a1a1aa;
  }

  .journal-content :global(li + li) {
    margin-top: 0.5rem;
  }

  .journal-content :global(a) {
    color: var(--color-accent);
    text-decoration: none;
  }

  .journal-content :global(a:hover) {
    text-decoration: underline;
  }

  .journal-content :global(a[href^="http"])::after {
    content: " ↗";
    font-size: 0.85em;
  }

  .journal-content :global(pre) {
    overflow-x: auto;
    padding: 1rem;
    border-radius: 0.75rem;
    background: #f4f4f5;
  }

  /* Paired photos */
  .journal-content :global(.photo-grid) {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    width: min(32rem, 100%);
    margin: 2.5rem auto;
  }

  .journal-content :global(.photo-grid img) {
    display: block;
    width: 100%;
    max-width: none;
    margin: 0;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;

    margin-bottom: 2rem;

    color: var(--color-muted);
    font-size: 0.875rem;
    text-decoration: none;

    transition: color 0.2s ease;
  }

  .back-link svg {
    width: 1rem;
    height: 1rem;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .journal-content :global(table) {
    display: block;
    overflow-x: auto;

    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }

  .journal-content :global(th),
  .journal-content :global(td) {
    padding: 0.625rem 0.75rem;
    text-align: left;
    vertical-align: top;
    border-bottom: 1px solid #e4e4e7;
  }

  .journal-content :global(th) {
    font-weight: 600;
    border-bottom: 2px solid #d4d4d8;
  }

  @media (min-width: 1024px) {
    .journal-article {
      margin-top: 8rem;
    }
  }
</style>
