---
// src/layouts/Layout.astro

import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "羽山 - Hayama",
  description = "羽山和行のホームページです。",
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />

    <link
      rel="canonical"
      href={new URL(Astro.url.pathname, Astro.site).toString()}
    />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={new URL(Astro.url.pathname, Astro.site).toString()}
    />
    <meta
      property="og:image"
      content={new URL("/ogp.png", Astro.site).toString()}
    />
    <meta property="og:image:alt" content="Hayama のホームページ" />
    <meta property="og:site_name" content="Hayama" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL("/ogp.png", Astro.site).toString()}
    />
    <meta name="twitter:image:alt" content="Hayama のホームページ" />

    <title>{title}</title>
  </head>
  <body>
    <div class="site-background">
      <div class="site-background-inner">
        <div class="site-panel"></div>
      </div>
    </div>
    <div class="site-content">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style>
  .site-background {
    position: fixed;
    inset: 0;
    display: flex;
    justify-content: center;
    padding-inline: 0;
  }

  .site-background-inner {
    display: flex;
    width: 100%;
    max-width: 80rem;
  }

  .site-panel {
    width: 100%;
    background: #fff;
    border-inline: 1px solid #f4f4f5;
  }

  .site-content {
    position: relative;
    display: flex;
    min-height: 100vh;
    width: 100%;
    flex-direction: column;
  }

  main {
    flex: 1;
  }

  @media (min-width: 640px) {
    .site-background {
      padding-inline: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .site-background-inner {
      padding-inline: 2rem;
    }
  }
</style>
